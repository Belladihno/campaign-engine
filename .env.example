# App
NODE_ENV=development
PORT=3000

# Database (Neon: split the connection string into parts, set DB_SSL=true.
# Use the DIRECT host (not the -pooler one) unless you know otherwise.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campaign_engine
DB_USER=postgres
DB_PASSWORD=secret
DB_SSL=false

# Redis — either a URL (Upstash: rediss://…; TLS + BullMQ settings forced
# on automatically) or parts (local Docker). URL wins when both are set.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT (24h expiry — no refresh tokens in this version)
JWT_SECRET=your-secret-here-min-32-chars
JWT_EXPIRY=24h

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# Where Paystack returns the user after checkout (deployed frontend URL).
# Unset locally — Paystack falls back to its dashboard callback.
# FRONTEND_URL=https://campaign-engine-tawny.vercel.app

# Africa's Talking
AT_API_KEY=your_at_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=CampaignEng
# Callback auth: registered as ?secret= on the AT dashboard URL.
# AT signs nothing — the secrecy of this URL IS the security.
AT_WEBHOOK_SECRET=generate-a-random-string

# SMS Provider mode
SMS_PROVIDER=sandbox
